<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_file_card"
    android:layout_marginBottom="8dp"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Extension badge -->
    <TextView
        android:id="@+id/tvExtension"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="TXT"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/bg_ext_badge"
        android:maxLines="1"
        android:letterSpacing="0.04"/>

    <!-- File info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvFilePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:maxLines="1"
            android:ellipsize="middle"
            android:paddingTop="2dp"/>

        <TextView
            android:id="@+id/tvFileSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:paddingTop="1dp"/>

    </LinearLayout>

    <!-- Score badge -->
    <TextView
        android:id="@+id/tvScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="82%"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/ru_crimson"
        android:background="@drawable/bg_score_badge"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"/>

</LinearLayout>
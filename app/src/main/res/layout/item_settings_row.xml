<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:id="@+id/llIconWrap"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:background="@drawable/bg_settings_icon"
        android:layout_marginEnd="12dp">
        <ImageView
            android:id="@+id/ivRowIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Setting"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"/>
        <TextView
            android:id="@+id/tvRowSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subtitle"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:layout_marginTop="1dp"/>
    </LinearLayout>

    <!-- Toggle (shown for boolean settings) -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"/>

    <!-- Chevron (shown for action settings) -->
    <ImageView
        android:id="@+id/ivChevron"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:tint="@color/text_hint"/>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ru_bg">

    <!-- Theme toggle — top-left on idle home (hidden during results) -->
    <FrameLayout
        android:id="@+id/themeToggleWrap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:elevation="8dp">

        <FrameLayout
            android:id="@+id/themeToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_theme_toggle"
            android:padding="@dimen/ru_theme_toggle_pad">

            <View
                android:id="@+id/themeToggleThumb"
                android:layout_width="@dimen/ru_theme_toggle_btn_w"
                android:layout_height="@dimen/ru_theme_toggle_btn_h"
                android:background="@drawable/bg_theme_toggle_thumb"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:elevation="4dp">

                <ImageButton
                    android:id="@+id/btnThemeLight"
                    android:layout_width="@dimen/ru_theme_toggle_btn_w"
                    android:layout_height="@dimen/ru_theme_toggle_btn_h"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_theme_sun"
                    android:scaleType="centerInside"
                    android:padding="3dp"
                    android:contentDescription="@string/theme_light"/>

                <ImageButton
                    android:id="@+id/btnThemeDark"
                    android:layout_width="@dimen/ru_theme_toggle_btn_w"
                    android:layout_height="@dimen/ru_theme_toggle_btn_h"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_theme_ink"
                    android:scaleType="centerInside"
                    android:padding="3dp"
                    android:contentDescription="@string/theme_dark"/>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Results-mode top chrome (search bar moves here) -->
    <LinearLayout
        android:id="@+id/llResultsTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:visibility="gone"
        android:alpha="0"
        android:elevation="12dp">

        <ImageView
            android:id="@+id/ivResultsWordmark"
            android:layout_width="@dimen/results_top_logo_size"
            android:layout_height="@dimen/results_top_logo_size"
            android:layout_gravity="start"
            android:scaleType="fitCenter"
            android:src="@drawable/ru_brand_logo"
            android:contentDescription="@string/app_name"/>

        <FrameLayout
            android:id="@+id/flResultsSearchHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:minHeight="400dp">

            <Space
                android:id="@+id/topSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <LinearLayout
                android:id="@+id/llHeroBranding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="@dimen/ru_content_padding_h"
                android:paddingEnd="@dimen/ru_content_padding_h">

                <ImageView
                    android:id="@+id/ivHomeWordmark"
                    android:layout_width="@dimen/home_brand_logo_size"
                    android:layout_height="@dimen/home_brand_logo_size"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ru_brand_logo"
                    android:contentDescription="@string/app_name"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_tagline_height"
                    android:layout_marginTop="@dimen/home_wordmark_tagline_gap"
                    android:layout_marginBottom="@dimen/home_tagline_search_gap">

                    <TextView
                        android:id="@+id/tvTaglineHi"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/tagline_hi"
                        android:textSize="21sp"
                        android:textStyle="italic"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/tiro_devanagari_hindi_regular"/>

                    <TextView
                        android:id="@+id/tvTaglineEn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/tagline_en"
                        android:textSize="20sp"
                        android:textStyle="italic"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/fraunces_semibold"
                        android:alpha="0"/>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llSearchBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="@dimen/ru_content_padding_h"
                android:paddingEnd="@dimen/ru_content_padding_h">

                <FrameLayout
                    android:id="@+id/flIdleSearchHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:id="@+id/llSearchBar"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/home_search_height"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_search_bar"
                        android:gravity="center_vertical"
                        android:paddingStart="22dp"
                        android:paddingEnd="8dp"
                        android:elevation="4dp"
                        android:clickable="true"
                        android:focusable="false"
                        android:descendantFocusability="afterDescendants">

                        <ImageView
                            android:layout_width="@dimen/ru_search_glyph_size"
                            android:layout_height="@dimen/ru_search_glyph_size"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_search"
                            app:tint="@color/text_secondary"
                            android:contentDescription="@null"/>

                        <FrameLayout
                            android:id="@+id/flSearchInputHost"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="4dp"
                            android:clipChildren="true"
                            android:clipToPadding="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSearch"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:hint=""
                                android:textColorHint="@color/text_secondary"
                                android:textSize="17sp"
                                android:fontFamily="@font/hanken_grotesk_regular"
                                android:textColor="@color/text_primary"
                                android:background="@null"
                                android:imeOptions="actionSearch"
                                android:inputType="text"
                                android:singleLine="true"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:cursorVisible="true"
                                android:importantForAccessibility="yes"
                                android:contentDescription="@string/hint_search_en"/>

                            <LinearLayout
                                android:id="@+id/llVoiceEq"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:visibility="gone">

                                <View android:layout_width="3.5dp" android:layout_height="12dp" android:background="@color/ru_crimson"/>
                                <View android:layout_width="3.5dp" android:layout_height="26dp" android:layout_marginStart="4dp" android:background="@color/ru_crimson"/>
                                <View android:layout_width="3.5dp" android:layout_height="18dp" android:layout_marginStart="4dp" android:background="@color/ru_crimson"/>
                                <View android:layout_width="3.5dp" android:layout_height="32dp" android:layout_marginStart="4dp" android:background="@color/ru_crimson"/>
                                <View android:layout_width="3.5dp" android:layout_height="14dp" android:layout_marginStart="4dp" android:background="@color/ru_crimson"/>
                                <View android:layout_width="3.5dp" android:layout_height="22dp" android:layout_marginStart="4dp" android:background="@color/ru_crimson"/>
                                <View android:layout_width="3.5dp" android:layout_height="10dp" android:layout_marginStart="4dp" android:background="@color/ru_crimson"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvSearchPlaceholder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:singleLine="true"
                                android:ellipsize="marquee"
                                android:marqueeRepeatLimit="marquee_forever"
                                android:scrollHorizontally="true"
                                android:text="@string/hint_search_en"
                                android:textColor="@color/text_secondary"
                                android:textSize="17sp"
                                android:fontFamily="@font/hanken_grotesk_regular"
                                android:elevation="4dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:importantForAccessibility="no"
                                android:visibility="gone"/>
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/flClearSearch"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="0dp"
                            android:visibility="gone">

                            <ImageButton
                                android:id="@+id/btnClearSearch"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_close"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:padding="5dp"
                                app:tint="@color/text_secondary"
                                android:visibility="gone"
                                android:contentDescription="@string/results_clear"/>
                        </FrameLayout>

                        <!-- Mic and enter share one slot — toggled in MainActivity -->
                        <FrameLayout
                            android:id="@+id/flSearchAction"
                            android:layout_width="@dimen/home_mic_size"
                            android:layout_height="@dimen/home_mic_size"
                            android:layout_marginEnd="4dp">

                            <ImageButton
                                android:id="@+id/btnSearch"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_enter"
                                android:background="@drawable/bg_mic_btn"
                                android:padding="12dp"
                                app:tint="@android:color/white"
                                android:visibility="gone"
                                android:contentDescription="@string/btn_search"/>

                            <FrameLayout
                                android:id="@+id/flMicWrap"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <View
                                    android:id="@+id/vMicBreathe"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_mic_breathe"/>

                                <View
                                    android:id="@+id/vMicRing1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_mic_ring"
                                    android:alpha="0"
                                    android:visibility="gone"/>

                                <View
                                    android:id="@+id/vMicRing2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_mic_ring"
                                    android:alpha="0"
                                    android:visibility="gone"/>

                                <ImageButton
                                    android:id="@+id/btnMic"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/ic_mic"
                                    android:background="@drawable/bg_mic_btn"
                                    android:padding="13dp"
                                    android:scaleType="centerInside"
                                    app:tint="@android:color/white"
                                    android:contentDescription="@string/settings_voice"/>
                            </FrameLayout>
                        </FrameLayout>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/llSearchHelper"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_helper_height"
                    android:layout_marginTop="@dimen/home_helper_margin_top">

                    <TextView
                        android:id="@+id/tvSearchHintIdle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/search_mic_hint_idle"
                        android:textSize="13.5sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/hanken_grotesk_regular"/>

                    <LinearLayout
                        android:id="@+id/tvSearchHintLive"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:alpha="0">

                        <View
                            android:id="@+id/vHintLiveDot"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/bg_hint_live_dot"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:text="@string/search_mic_hint_listening"
                            android:textSize="13.5sp"
                            android:textColor="@color/ru_crimson"
                            android:fontFamily="@font/hanken_grotesk_medium"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <Space
                android:id="@+id/bottomSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Results panel — positioned below search chrome in code -->
    <LinearLayout
        android:id="@+id/resultsSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_results_sheet"
        android:visibility="gone"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/llSheetDragZone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/a11y_results_sheet_drag">

            <View
                android:id="@+id/vSheetHandle"
                android:layout_width="42dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_sheet_handle"/>

            <TextView
                android:id="@+id/tvResultsCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp"
                android:textSize="20sp"
                android:fontFamily="@font/fraunces_semibold"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llSharePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="6dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_share_picker"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSharePickerLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/share_picker_title"
                        android:textSize="11sp"
                        android:fontFamily="@font/hanken_grotesk_medium"
                        android:textColor="@color/ru_crimson"/>

                    <TextView
                        android:id="@+id/tvSharePickerFile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="14sp"
                        android:fontFamily="@font/hanken_grotesk_medium"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/tvSharePickerPosition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnShareCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:gravity="center"
                    android:text="@string/share_picker_cancel"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/hanken_grotesk_medium"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

                <TextView
                    android:id="@+id/btnShareNext"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:gravity="center"
                    android:text="@string/share_picker_next"
                    android:textSize="12sp"
                    android:textColor="@color/ru_crimson"
                    android:fontFamily="@font/hanken_grotesk_medium"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/btnShareConfirm"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:gravity="center"
                    android:text="@string/share_picker_send"
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:fontFamily="@font/hanken_grotesk_medium"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_primary"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/flResultsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResults"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:focusable="false"
                android:focusableInTouchMode="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <LinearLayout
                android:id="@+id/llResultsEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp"
                android:visibility="gone">

            <TextView
                android:id="@+id/tvResultsEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/hanken_grotesk_medium"/>

            <TextView
                android:id="@+id/tvResultsEmptySub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/hanken_grotesk_regular"
                android:lineSpacingMultiplier="1.4"/>

            <TextView
                android:id="@+id/btnResultsEmptyAction"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/results_empty_go_index"
                android:textSize="14sp"
                android:textColor="@color/ru_crimson"
                android:fontFamily="@font/hanken_grotesk_semibold"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone"/>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvResultsEmpty"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/hanken_grotesk_regular"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="8dp"
            android:visibility="gone"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

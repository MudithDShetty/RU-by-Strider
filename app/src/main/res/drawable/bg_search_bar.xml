<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Warm soft drop shadow (handoff card-shadow) -->
    <item
        android:bottom="2dp"
        android:left="6dp"
        android:right="6dp"
        android:top="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <solid android:color="@color/ru_search_bar_shadow" />
        </shape>
    </item>

    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ru_search_bar_fill" />
            <corners android:radius="34dp" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
        </shape>
    </item>
</layer-list>

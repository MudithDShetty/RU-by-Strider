<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ru_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Top bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="9:41"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/btnIndexShortcut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Index"
                    android:textSize="12sp"
                    android:textColor="@color/ru_crimson"
                    android:fontFamily="sans-serif-medium"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

            </LinearLayout>

            <!-- Center block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="48dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <!-- RU wordmark -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RU"
                    android:textSize="72sp"
                    android:fontFamily="serif"
                    android:textStyle="bold"
                    android:textColor="@color/ru_dark"
                    android:letterSpacing="-0.05"
                    android:lineSpacingMultiplier="1.0"/>

                <!-- Tagline -->
                <TextView
                    android:id="@+id/tvTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline_en"
                    android:textSize="13sp"
                    android:fontFamily="serif"
                    android:textStyle="italic"
                    android:textColor="@color/ru_crimson"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="40dp"/>

                <!-- Search bar -->
                <LinearLayout
                    android:id="@+id/llSearchBar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_hint"
                        xmlns:app="http://schemas.android.com/apk/res-auto"/>

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:hint="@string/hint_search_en"
                        android:textColorHint="@color/text_hint"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:background="@null"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true"/>

                    <ImageButton
                        android:id="@+id/btnMic"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_mic"
                        android:background="@drawable/bg_mic_btn"
                        android:padding="10dp"
                        app:tint="@android:color/white"
                        android:contentDescription="Voice search"
                        xmlns:app="http://schemas.android.com/apk/res-auto"/>

                </LinearLayout>

                <!-- Category filter chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:id="@+id/llChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingEnd="8dp">

                        <TextView
                            android:id="@+id/chipAll"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="All"
                            android:textSize="12sp"
                            android:textColor="@android:color/white"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:background="@drawable/bg_category_chip_selected"
                            android:clickable="true"
                            android:focusable="true"/>

                        <TextView
                            android:id="@+id/chipDocs"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Docs"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_category_chip"
                            android:clickable="true"
                            android:focusable="true"/>

                        <TextView
                            android:id="@+id/chipMedia"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Media"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_category_chip"
                            android:clickable="true"
                            android:focusable="true"/>

                        <TextView
                            android:id="@+id/chipWork"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Work"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_category_chip"
                            android:clickable="true"
                            android:focusable="true"/>

                        <TextView
                            android:id="@+id/chipId"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="ID"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_category_chip"
                            android:clickable="true"
                            android:focusable="true"/>

                    </LinearLayout>
                </HorizontalScrollView>

            </LinearLayout>

            <!-- Recent section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recent"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_hint"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp"/>

                <!-- Results list / recent list -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    xmlns:app="http://schemas.android.com/apk/res-auto"/>

                <!-- Status text -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_loading"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp"/>

                <!-- Horizontal progress bar -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/ru_crimson"
                    android:visibility="visible"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
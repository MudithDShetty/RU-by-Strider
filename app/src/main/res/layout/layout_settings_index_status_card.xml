<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardIndexStatusRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:background="@drawable/bg_settings_card"
    android:elevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="@dimen/ru_settings_icon_tile"
        android:layout_height="@dimen/ru_settings_icon_tile"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_settings_icon">

        <ImageView
            android:layout_width="@dimen/ru_settings_icon_glyph"
            android:layout_height="@dimen/ru_settings_icon_glyph"
            android:layout_gravity="center"
            android:scaleType="centerInside"
            android:src="@drawable/ic_index"
            app:tint="@color/ru_crimson"
            android:importantForAccessibility="no"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/RuText.RowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_index_status_title"/>

        <TextView
            android:id="@+id/tvIndexStatusCount"
            style="@style/RuText.RowSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_index_status_count_zero"/>

        <TextView
            android:id="@+id/tvIndexStatusLast"
            style="@style/RuText.RowSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_index_status_last_never"/>
    </LinearLayout>

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_hint"
        android:importantForAccessibility="no"/>

</LinearLayout>

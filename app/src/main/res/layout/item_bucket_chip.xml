<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_bucket_chip"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="8dp"
    android:elevation="2dp">

    <View
        android:id="@+id/vBucketDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_ext_badge"/>

    <TextView
        android:id="@+id/tvBucketCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textSize="12sp"
        android:fontFamily="@font/hanken_grotesk_semibold"
        android:textColor="@color/text_primary"/>

    <TextView
        android:id="@+id/tvBucketName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textSize="12sp"
        android:fontFamily="@font/hanken_grotesk_regular"
        android:textColor="@color/text_secondary"/>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_result_row"
    android:layout_marginBottom="10dp"
    android:paddingStart="13dp"
    android:paddingEnd="13dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/flThumb"
        android:layout_width="@dimen/result_thumb_size"
        android:layout_height="@dimen/result_thumb_size"
        android:background="@drawable/bg_result_thumb_pdf">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/tvExtensionFallback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="PDF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:textColor="@color/ru_crimson"
            android:maxLines="1"
            android:visibility="gone"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="@dimen/result_thumb_size"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="13dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/result_file_name_min_height"
            android:gravity="center_vertical"
            android:textSize="@dimen/result_file_name_text_size"
            android:lineSpacingExtra="2dp"
            android:fontFamily="@font/hanken_grotesk_medium"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/result_file_meta_gap">

            <View
                android:id="@+id/vSourceDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_ext_badge"/>

            <TextView
                android:id="@+id/tvFileSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="@dimen/result_file_meta_text_size"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/hanken_grotesk_regular"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_chevron_right"
        android:alpha="0.55"
        app:tint="@color/text_secondary"
        android:contentDescription="@null"/>

    <TextView
        android:id="@+id/tvScore"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvFilePath"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvFileSize"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

</LinearLayout>

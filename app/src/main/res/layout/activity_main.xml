<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ru_bg">

    <!-- Main content container — switched by MainActivity -->
    <FrameLayout
        android:id="@+id/flContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="@dimen/ru_nav_clearance"/>

    <!-- Bottom nav bar — floating pill -->
    <FrameLayout
        android:id="@+id/llNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_nav_bar"
            android:elevation="2dp">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/navHomeIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_home"
                    app:tint="@color/nav_tab_icon"/>
                <TextView
                    android:id="@+id/navHomeLabel"
                    style="@style/RuText.TabLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/nav_home"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navIndex"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/navIndexIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_index"
                    app:tint="@color/nav_tab_icon"/>
                <TextView
                    android:id="@+id/navIndexLabel"
                    style="@style/RuText.TabLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/nav_index"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navAnalytics"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/navAnalyticsIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_analytics"
                    app:tint="@color/nav_tab_icon"/>
                <TextView
                    android:id="@+id/navAnalyticsLabel"
                    style="@style/RuText.TabLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/nav_analytics"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/navSettingsIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/nav_tab_icon"/>
                <TextView
                    android:id="@+id/navSettingsLabel"
                    style="@style/RuText.TabLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/nav_settings"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Name onboarding — full-screen in-app page (not a dialog) -->
    <FrameLayout
        android:id="@+id/onboardingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ru_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:elevation="14dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp">

                <TextView
                    android:id="@+id/tvOnboardingWordmark"
                    style="@style/RuText.Wordmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- First-run model setup — inline card, not a separate scrim overlay -->
                <LinearLayout
                    android:id="@+id/llOnboardingSetup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:background="@drawable/bg_onboarding_setup_card"
                    android:visibility="gone">

                    <TextView
                        style="@style/RuText.SectionHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_setup_label"/>

                    <TextView
                        android:id="@+id/tvOnboardingSetupTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/onboarding_setup_title"
                        android:textSize="18sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/fraunces_semibold"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvOnboardingSetupMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/status_first_load"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/hanken_grotesk_medium"
                        android:gravity="center"/>

                    <ProgressBar
                        android:id="@+id/onboardingSetupProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="14dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/ru_crimson"
                        android:progressBackgroundTint="@color/ru_crimson_light"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/onboarding_setup_sub"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/hanken_grotesk_regular"
                        android:lineSpacingMultiplier="1.45"
                        android:gravity="center"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOnboardingTitle"
                    style="@style/RuText.OnboardingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="@string/onboarding_name_title"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvOnboardingSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:maxWidth="300dp"
                    android:text="@string/onboarding_name_sub"
                    android:textSize="13.5sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.55"
                    android:fontFamily="@font/hanken_grotesk_regular"
                    android:gravity="center"/>

                <EditText
                    android:id="@+id/etOnboardingName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp"
                    android:hint="@string/onboarding_name_hint"
                    android:textColorHint="@color/text_hint"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/hanken_grotesk_regular"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="2"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:background="@drawable/bg_onboarding_field"/>

                <TextView
                    android:id="@+id/btnOnboardingSave"
                    style="@style/RuText.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/onboarding_name_save"
                    android:background="@drawable/bg_btn_primary"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/btnOnboardingSkip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/onboarding_name_skip"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/hanken_grotesk_medium"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Toast snackbar -->
    <LinearLayout
        android:id="@+id/llToast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/bg_toast"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:elevation="12dp">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_check"
            app:tint="@color/ru_crimson"/>
        <TextView
            android:id="@+id/tvToast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
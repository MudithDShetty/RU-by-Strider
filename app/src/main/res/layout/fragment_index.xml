<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ru_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="400dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="@dimen/ru_content_padding_h"
            android:paddingEnd="@dimen/ru_content_padding_h">

            <TextView
                android:id="@+id/tvIndexWordmark"
                style="@style/RuText.Wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/index_subtitle"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/hanken_grotesk_regular"/>

            <FrameLayout
                android:layout_width="188dp"
                android:layout_height="188dp"
                android:layout_marginTop="@dimen/index_dial_margin_top">

                <com.strider.quanto.ui.IndexProgressDialView
                    android:id="@+id/indexDial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/tvDialCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="46sp"
                        android:fontFamily="@font/fraunces_semibold"
                        android:textColor="@color/text_primary"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/index_files_label"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/hanken_grotesk_regular"/>
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvIndexPhase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="18dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/index_phase_idle"
                android:textSize="@dimen/index_phase_text_size"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/hanken_grotesk_regular"/>

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/flexBuckets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/index_buckets_margin_top"
                android:visibility="gone"
                app:flexWrap="wrap"
                app:justifyContent="center"
                app:alignItems="center"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIndex"
                style="@style/RuButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/index_button_margin_top"
                android:text="@string/btn_index"
                app:icon="@drawable/ic_refresh"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@android:color/white"/>

            <ProgressBar
                android:id="@+id/progressScanBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="248dp"
                android:layout_height="4dp"
                android:layout_marginTop="14dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/ru_crimson"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvCurrentFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textSize="11.5sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="middle"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvIndexHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/index_hint_idle"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/hanken_grotesk_regular"/>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
</ScrollView>

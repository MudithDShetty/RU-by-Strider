<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StriderQuanto" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/ru_crimson</item>
        <item name="colorPrimaryVariant">@color/ru_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSurface">@color/surface_solid</item>
        <item name="android:windowBackground">@color/ru_bg</item>
        <item name="android:statusBarColor">@color/ru_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="RuButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="RuButton.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/ru_crimson</item>
        <item name="android:textSize">14sp</item>
        <item name="strokeColor">@color/ru_crimson</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="RuChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:textSize">12sp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipStrokeColor">@color/divider</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>